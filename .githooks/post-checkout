#!/bin/sh
# rev6 外層 post-checkout — 同 post-merge 之提示（LL-00095）：$1＝舊 HEAD、$2＝新 HEAD（切分支與 rebase 內部之 checkout 皆經此）。
# 單檔還原（`git checkout -- <檔>`）兩參數相同、不帶路徑資訊，不在涵蓋內（RUNBOOK §2）。只提示、恆 exit 0（不擋、不動容器）。
f=deploy/trust-model.dev.toml
if [ -n "$(git diff --name-only "$1" "$2" -- "$f" 2>/dev/null)" ]; then
  echo "⚠ $f 已變動（單檔 bind mount、容器內該檔已懸空）→ 依 RUNBOOK §2 重建 rust-api：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --force-recreate --no-deps rust-api" >&2
fi
exit 0
