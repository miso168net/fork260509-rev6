#!/bin/sh
# rev6 pre-commit：機密掃描（樣式層 betterleaks）→ docsync check（GT-01）＋lint（其餘閘）→ staged 工具自測 → rust-fmt／wire-schema／fork-delta（rust-api／base-web pin bump、工具本體或憲法 staged 時條件實跑；碼面閘名冊＝RUNBOOK §12 碼面閘表）→ entity-drift（rust-api pin bump／schema 快照 staged 時條件實跑；快照缺席即紅）→ schema-frozen（凍結 fixtures／data-model／schema-definition staged 時條件實跑）→ orchestration（tools/orchestration/ 之 *.js|*.mjs|*.py staged 時以三支入庫範例組裝＋harness）。★接線字面由 tools/docsync/tests/test_hook_wiring.py 機器守（BL-00023；hook 本體 staged 時自跑 docsync test）。
# 範圍字串（GT-12 三處名冊同源之一）：GT-01～GT-12
# 被擋時：錯誤訊息附去處；同回合修復後重試。
#
# ★兩種語意（承 rev5 hook 契約、rev4:019 scan-gates）：
#   事件型（機密掃描）：--no-verify 繞過＝機密「真進 git 歷史」、不可逆——僅剩 pre-push 第二層同套規則補攔；
#     被誤擋一律修 .gitleaks.toml allowlist（AND＋paths×regexes 圈定）、絕不養成 --no-verify 慣性。
#   狀態型（docsync check／lint 與工具自測）：--no-verify 只延後、下次 commit 檢查不消失。
#
# 樣式掃描：★--redact 不可省（預設 0＝明文噴進終端與 scrollback）；★一律 git 子命令；★原生二進位、禁容器形式
# （容器不帶 GIT_INDEX_FILE → `git commit -a` 掃 0 bytes 靜默漏報）；exit code 分流＝2 機密命中／其餘非零＝掃描器
# 本身異常（含 127 缺 binary）。★`--config` 顯式帶、不靠自動探索：探索不到 config 時 betterleaks 靜默降級為內建
# 規則庫並回 rc 0（自訂 DSN 規則一併下線）；顯式帶則 config 缺席即 rc 1 落入「掃描器異常」分支＝吵鬧失敗。
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# ── 全鏈時間門檻（承 rev5:ADR 0044 雙錨：WARN 45＝最壞合法實測進位、FAIL 90＝病態）──────────
# ★門檻調整走 ADR、不得就地改數字；收刀簿記型 commit 的實測值每刀 append 一筆 close_bookkeeping perf 事件
#   （人讀 docs/generated/reference/perf.md），連續兩刀 ≥60s 即強制「優化慢路徑／再立 ADR／縮減名冊」三者之一。
PRECOMMIT_WARN_SEC=45
PRECOMMIT_FAIL_SEC=90
PRECOMMIT_T0=$(date +%s)
# ── 並行 harness（承 rev5:ADR 0061）：各閘唯讀、無共享可變狀態，並行派發讓 drvfs（9p）I/O 延遲重疊；
#   語意不變（任一閘非零即 exit 1）、不 fail-fast——全部跑完後依派發順序回放輸出，一次看齊所有問題。
#   ★betterleaks 刻意留在序列最前：事件型、失敗要最先最顯眼地擋下。輸出各存暫存檔、回放不交錯。
PC_TMP=$(mktemp -d) || { echo "[pre-commit] ✗ 無法建立暫存目錄" >&2; exit 1; }
trap 'rm -rf "$PC_TMP"' EXIT
PC_ORDER=""
pc_run() {
  _pc_label=$1; shift
  PC_ORDER="$PC_ORDER $_pc_label"
  ( "$@" >"$PC_TMP/$_pc_label.out" 2>&1; echo $? >"$PC_TMP/$_pc_label.rc" ) &
}
pc_join() {
  wait
  _pc_fail=0
  for _pc_l in $PC_ORDER; do
    [ -s "$PC_TMP/$_pc_l.out" ] && cat "$PC_TMP/$_pc_l.out"
    _pc_rc=$(cat "$PC_TMP/$_pc_l.rc" 2>/dev/null || echo 1)
    if [ "$_pc_rc" -ne 0 ]; then
      echo "[pre-commit] ✗ 閘「${_pc_l}」失敗（exit ${_pc_rc}）——處置見其上方輸出" >&2
      _pc_fail=1
    fi
  done
  return $_pc_fail
}
betterleaks git --config "$HOOK_DIR/../.gitleaks.toml" --pre-commit --staged --redact --verbose --exit-code 2
scan_rc=$?
if [ "$scan_rc" -eq 2 ]; then
  echo "[pre-commit] ✗ 機密樣式命中（上方輸出含 rule id 與檔案行、值已遮蔽）——自 staged 移除後重試；誤報→修 .gitleaks.toml allowlist（AND＋paths×regexes 圈定）、絕不 --no-verify" >&2
  exit 1
elif [ "$scan_rc" -ne 0 ]; then
  echo "[pre-commit] ✗ 掃描器本身異常（exit ${scan_rc}）、非機密命中——跑 bash tools/bootstrap.sh 檢修（安裝／釘版斷言）" >&2
  exit 1
fi
# 值比對層（機密現值 × tracked 文字檔）住 docsync lint 的 GT-07（樣式四組自測＋SECRETS_DIR 實值）——與 check／lint 並行跑。
pc_run "docsync-check" python3 "$HOOK_DIR/../tools/docsync" check
pc_run "docsync-lint" python3 "$HOOK_DIR/../tools/docsync" lint
# 守門工具自測條件觸發：staged 含某工具本體才跑該支、平時零開銷（名冊與 GT-09／bootstrap 對賬）。★hook 本體 staged 亦跑 docsync test（接線守衛 test_hook_wiring 隨之；BL-00023）。
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q '^tools/docsync/\|^\.githooks/pre-commit$'; then
  pc_run "selftest-docsync" python3 "$HOOK_DIR/../tools/docsync" test
fi
for t in tools/wf-watchdog.py tools/schema-gate.py tools/entity-drift-gate.py tools/rust-fmt-gate.py tools/wire-schema.py tools/fork-delta-lint.py deploy/preflight-secrets.py deploy/decrypt-secrets.py deploy/generate-secrets.py deploy/setup-reaper-role.py deploy/backup-db.py; do
  if echo "$staged" | grep -qxF "$t"; then
    pc_run "selftest-$(basename "$t" .py)" python3 "$HOOK_DIR/../$t" test
  fi
done
# ── 三支碼面閘（002 刀 U0 隨遷自 rev5:.githooks/pre-commit 同段形；名冊＝RUNBOOK §12 碼面閘表、GT-12 腿對賬；皆入上方 for 自測迴圈）──
# rust 格式閘（承 rev5:B-112／rev5:ADR 0057 決定 3）：rust-api gitlink 變動（pin bump）或本工具本體 staged 時，於 rust-api 容器內跑
# `cargo fmt --all --check`（唯讀、設定＝rust-api/rustfmt.toml）。★本段刻意零條件判斷：跳過邏輯住工具內——docker 不在 PATH／
# compose 兩檔缺／rust-api 容器未在跑＝工具具名跳過 rc 0（「stack 沒起時 pre-commit MUST 可用」紀律不變）；容器在跑而 cargo-fmt 缺
# ＝rc 2 fail-loud、刻意不設豁免；未格式化＝rc 1 擋。跳過分支使離線 commit 仍可能帶入未格式化碼——下一次 stack 在跑的 pin bump 擋下、
# 屬延遲一站而非漏網。self-test 不隨 check 連帶跑、故本體走 for 迴圈形。
if echo "$staged" | grep -qxF -e 'rust-api' -e 'tools/rust-fmt-gate.py'; then
  pc_run "rust-fmt" python3 "$HOOK_DIR/../tools/rust-fmt-gate.py" check
fi
# wire 契約閘（承 rev4:B-128）：base-web 或 rust-api gitlink 變動（pin bump）時重抽 typings 與快照 rust-api/server/tests/fixtures/wire-schema.json
# byte 比對——★雙側觸發（BL-00037③；對稱於下方 entity-drift）：typings 側住 base-web、快照側住 rust-api worktree（外層 staged 面
# 只看得到 rust-api gitlink、快照檔本身永不現身於此），任一側動到自己那面就得重抽；sh 只做粗判（哪個 gitlink staged）、
# 兩側 pin 區間各自零變動之細判在 python 內（--staged-gate 收窄、省 npx 秒數）；
# docker 缺／base-web 容器未起＝具名跳過 rc 0；容器可用但重抽失敗、快照缺席或不一致＝rc 2 擋（補救見工具輸出）。
if echo "$staged" | grep -qxF -e 'base-web' -e 'rust-api'; then
  pc_run "wire-schema" python3 "$HOOK_DIR/../tools/wire-schema.py" check --staged-gate
fi
# fork-delta 標記閘（憲法 §III）：base-web gitlink 變動（pin bump）時機器比對 base-web vs 源倉 example 基線——修改型缺 `原行:`／
# 新增型缺圈界／軌道授權外即擋 rc 1；工具本體 staged 時亦直跑一次（無引數＝self-test＋全掃）。★第三個觸發源＝憲法：`load_roster()`
# 讀 §III.1／§III.2 兩表當授權名冊（含空 ★表哨兵句斷言），純 §V.2 Amendment commit 也當場紅、不等下一次 pin bump 才誤歸因。
# ★源倉缺席或未切在 example＝工具首步斷言 die rc 2（fail-loud）；本段不設跳過分支——bootstrap 已斷言源倉在場且在 example。
if echo "$staged" | grep -qxF -e 'base-web' -e 'tools/fork-delta-lint.py' -e '.specify/memory/constitution.md'; then
  pc_run "fork-delta" python3 "$HOOK_DIR/../tools/fork-delta-lint.py"
fi
# entity 漂移閘（碼面閘、不入 GATES 名冊；承 rev5:.githooks/pre-commit 同段形、rev4:B-110 階段 0）：rust-api gitlink 變動
# （pin bump）或 schema 快照本身 staged 時，比對 rust-api/entity/src vs 工作樹快照（＝待提交態）docs/ops/reference-src/schema-snapshot.json
# ——零 docker、秒級；casbin_rule 雙向豁免（rev4:ADR 0015）；有漂移＝rc 1、entity 目錄缺席等結構異常＝rc 2、皆擋（補救見工具輸出）。
# ★快照缺席＝rc 2 擋下＋提示照相（002 刀 U0；rev5 與 001 刀為 Day-1 具名跳過——快照成 tracked 檔後該分支恆為死支且 fail-open：
#   快照被誤刪／checkout 掉＝靜默放行）；快照在場而漂移＝照擋。
if echo "$staged" | grep -qxF -e 'rust-api' -e 'docs/ops/reference-src/schema-snapshot.json'; then
  if [ -f "$HOOK_DIR/../docs/ops/reference-src/schema-snapshot.json" ]; then
    pc_run "entity-drift" python3 "$HOOK_DIR/../tools/entity-drift-gate.py" check
  else
    pc_run "entity-drift" sh -c 'echo "[pre-commit] ✗ entity-drift：schema 快照 docs/ops/reference-src/schema-snapshot.json 缺席——跑 python3 tools/docsync refresh 照相（需 dev stack）、git add 快照後重試" >&2; exit 2'
  fi
fi
# 凍結面守門（碼面閘、不入 GATES 名冊；規格對照審查修單 I-3）：`specs/001-schema-baseline/fixtures/` 或
# `data-model.md`（凍結存證）或 `docs/ops/reference-src/schema-definition.md`（活體定稿）staged 時跑 schema-gate 自帶測試（含真 repo doccheck 綠案＝凍結 fixtures × 定稿
# 五元組機器對賬、fixtures 形斷言、假 delta 合成）——零 docker、實測 0.36 秒。
# ★理由：contracts/fixtures.md §4 定凍結面位元變更為「違憲級」，但生成器與 GT-01～GT-12 皆不掃它；
#   原「不設閘」取捨的成本前提（離線閘昂貴）經量測不成立（doccheck 0.17 秒），故補此條件觸發。
if echo "$staged" | grep -qE '^(specs/001-schema-baseline/(fixtures/|data-model\.md$)|docs/ops/reference-src/schema-definition\.md$)'; then
  pc_run "schema-frozen" python3 "$HOOK_DIR/../tools/schema-gate.py" test
fi
# 編排骨架段（BL-00023 併入項）：暫存區含 tools/orchestration/ 之 *.js|*.mjs|*.py（含生成物 _sk_rules.js＝RULES 改動亦重驗）時，以三支入庫範例組裝到
# 暫存目錄並跑對應 harness（assemble.py 三道自檢＝RULES-VERSION 對賬／node --check／harness-test spec＋quality 或 harness-review）；產物只落 ${PC_TMP}、trap 清除。
# 改壞骨架或範例的 commit 在此被擋（此前只在人手動組裝時才會現形）；node 為硬相依、秒級。
if echo "$staged" | grep -qE '^tools/orchestration/.*\.(js|mjs|py)$'; then
  pc_run "orchestration" sh -c 'for u in EXAMPLE-tdd-unitdef EXAMPLE-review-unitdef EXAMPLE-review-verify-unitdef; do python3 "$1/../tools/orchestration/assemble.py" "$1/../tools/orchestration/$u.py" "$2/$u.mjs" || exit 1; done' _ "$HOOK_DIR" "$PC_TMP"
fi
pc_join || exit 1
# ── 全鏈耗時評估（僅在全部閘通過後執行）──────────────────────────────────────
PRECOMMIT_ELAPSED=$(( $(date +%s) - PRECOMMIT_T0 ))
if [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_FAIL_SEC" ]; then
  echo "[pre-commit] ✗ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出硬上限 ${PRECOMMIT_FAIL_SEC}s——所有檢查已通過，擋下的是效能劣化：①先量哪段吃時間再優化 ②立 ADR 調門檻並記錄劣化理由。★狀態型：--no-verify 只延後（解「調門檻的 commit 被自己擋住」死結）。" >&2
  exit 1
elif [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_WARN_SEC" ]; then
  echo "[pre-commit] ⚠ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出警戒線 ${PRECOMMIT_WARN_SEC}s（硬上限 ${PRECOMMIT_FAIL_SEC}s）——劣化趨勢訊號，放行不擋。" >&2
fi
