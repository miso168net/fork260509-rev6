{
  "uid": "obs-audit-log",
  "title": "審計日誌 (Audit Log)",
  "tags": [
    "obs",
    "rev6-admin",
    "audit-log",
    "loki"
  ],
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "{compose_project=\"rev6-admin\"}",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "trace_id",
        "label": "trace_id (drill)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "輸入 trace_id 過濾 rust-api log；rev6 稽核列此欄恆空（sys_access_log／sys_operation_log／sys_login_attempt 之 trace_id 恆 NULL）、rust-api 結構化 log 亦不帶 trace_id 欄＝填值即無命中。留空＝不過濾。"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "全工作區 log（本工作區、compose_project=rev6-admin）",
      "description": "{compose_project=\"rev6-admin\", service=~\"$service\"}；★ 僅本工作區 log（rev4:FR-007）。包含結構化與非結構化（cargo-watch 等）行。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_project=\"rev6-admin\", service=~\"$service\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "rust-api 結構化 log（JSON guard）",
      "description": "{compose_project=\"rev6-admin\", service=\"rust-api\"} |~ `^{` | json；★ 行首 JSON guard（|~ `^{`）過濾非-JSON 行（cargo-watch），否則 | json 對純文字回 400 整片空白。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_project=\"rev6-admin\", service=\"rust-api\"} |~ `^{` | json",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "trace_id drill（rust-api、依 $trace_id 過濾）",
      "description": "{compose_project=\"rev6-admin\", service=\"rust-api\"} |~ `^{` | json | fields_trace_id =~ `$trace_id`；★ 查詢形＝tracing 事件欄巢狀於 fields、loki | json 攤平為 fields_<欄名>（本面板取 fields_trace_id）。rev6 稽核列此欄恆空：sys_access_log／sys_operation_log／sys_login_attempt 之 trace_id 無料源、恆 NULL（session_event 無此欄），rust-api 結構化 log 亦不帶 trace_id 欄＝$trace_id 留空時空 regex `` 匹配全部行、填值即無命中。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_project=\"rev6-admin\", service=\"rust-api\"} |~ `^{` | json | fields_trace_id =~ `$trace_id`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "log 量速率 by service（行/秒）",
      "description": "sum by (service) (rate({compose_project=\"rev6-admin\"}[5m]))；各 service log 產出速率。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (rate({compose_project=\"rev6-admin\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "稽核容量趨勢 (n_live_tup 四表)",
      "description": "pg_stat_user_tables_n_live_tup{relname=~\"sys_operation_log|sys_access_log|sys_login_attempt|session_event\"}；稽核四表活列數趨勢（告警④同錨：稽核四表＝`docs/ops/reference-src/archetype-map.json` 變體 B、門檻 1000000）。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_stat_user_tables_n_live_tup{relname=~\"sys_operation_log|sys_access_log|sys_login_attempt|session_event\"}",
          "legendFormat": "{{relname}}"
        }
      ]
    }
  ]
}
